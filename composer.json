{
    "name": "mgn/wpblock_copy",
    "description": "フロント表示の際にそのページのブロック構造をコピーできるボタンを設置する WordPress プラグイン",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "mgn",
            "email": "noreply@m-g-n.me",
            "homepage": "https://m-g-n.me/"
        }
    ],
    "require": {
        "php": ">=8.1",
        "inc2734/wp-github-plugin-updater": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Mgn\\Wpblock_copy\\App\\": "App/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^4.0"
    }
}
